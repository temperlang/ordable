{
  "//": "For editors: finds Ordable in temper.out (temper build -b js) for types. Files opt into checking with // @ts-check; not strict, since plain JS and Temper's runtime aren't written for it.",
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "paths": {
      "ordable": [
        "../temper.out/js/ordable/index.js"
      ],
      "@temperlang/core": [
        "../temper.out/js/temper-core/index.js"
      ]
    },
    "strict": false
  },
  "include": [
    "*.js",
    "*.d.ts"
  ],
  "exclude": [
    "build",
    "node_modules"
  ]
}
